{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024"],
    "types": ["node"],
    "noEmit": true,
    "composite": true,
    "allowJs": true
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "openapi-ts.config.ts",
    "openapi-ts.shared.mjs",
    "scripts/**/*.mjs",
    "scripts/**/*.ts",
    "e2e/**/*.ts"
  ]
}
