{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    // `DOM` is here only for `e2e/**/*.ts` (Playwright browser-context
    // callbacks — `page.evaluate`/`addInitScript` bodies reference `window`
    // and `document`, and TypeScript checks their source text against
    // *this* project's `lib`, even though they actually run in Chromium,
    // not Node). Everything else in this project runs under Node and never
    // uses a DOM global; if `@types/node` and `lib.dom.d.ts` ever disagree
    // on a shared name (`fetch`, `Response`, `AbortSignal`, ...), Node's
    // definition wins per `tsconfig.base.json`'s `skipLibCheck`.
    "lib": ["ES2024", "DOM"],
    "types": ["node"],
    "noEmit": true,
    "composite": true,
    "allowJs": true
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "openapi-ts.config.ts",
    "openapi-ts.shared.mjs",
    "scripts/**/*.mjs",
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    // WP 10.8: e2e/tokens.spec.ts compares the browser's computed colours to the generated token object.
    "src/styles/tokens.ts",
    "src/styles/tokens/fills.ts"
  ]
}
