    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react-swc": "4.3.3",
    "@vitest/coverage-v8": "5.0.0",
    "axe-core": "4.13.0",
    "happy-dom": "20.14.0",
