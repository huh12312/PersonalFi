{
  "name": "@app/web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "React 19 + Vite 7 + TanStack Router/Query SPA. Tailwind v4, shadcn/ui on Base UI (vendored), visx charts, self-hosted fonts and icons, no CDNs, no analytics.",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run gen && tsc -b --noEmit && vite build && node scripts/strip-sourcemaps.ts && node scripts/check-sw-precache.ts && node scripts/check-csp.ts",
    "build:e2e-csp": "vite build --mode e2e-csp --outDir dist-e2e-csp",
    "preview": "vite preview",
    "typecheck": "pnpm run gen && tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen": "openapi-ts",
    "gen:check": "node scripts/check-openapi-drift.ts"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@core/kernel": "workspace:*",
    "@hey-api/client-fetch": "0.13.1",
    "@hookform/resolvers": "5.9.1",
    "@simplewebauthn/browser": "14.0.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.10",
    "@visx/axis": "4.0.0",
    "@visx/brush": "4.0.0",
    "@visx/curve": "4.0.0",
    "@visx/event": "4.0.0",
    "@visx/gradient": "4.0.0",
    "@visx/group": "4.0.0",
    "@visx/responsive": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "@visx/tooltip": "4.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "comlink": "^4.4.2",
    "d3-array": "3.2.4",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "d3-time-format": "4.1.0",
    "date-fns": "4.4.0",
    "lucide-react": "1.40.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4"
