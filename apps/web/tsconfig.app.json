{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "allowJs": false,
    "noEmit": true,
    // `src/api/generated` (regenerated by `pnpm gen`, never hand-edited) is
    // reachable from included files (`src/main.tsx`, `src/lib/sse.ts`, every
    // feature hook) no matter how it's listed in `include`/`exclude`: a
    // `composite` project's `tsc -b` raises TS6307 ("Projects must list all
    // files") the moment an *included* file imports an *excluded* one, which
    // is exactly this shape once the OpenAPI contract grew SSE routes and
    // `@hey-api/client-fetch` started emitting a `client/`+`core/` split
    // (previously one flat `client.gen.ts`). A second, relaxed-settings
    // project referenced from here can't fix it either: `tsc -b --noEmit`
    // (this project's own "typecheck"/"build" script) forces emit off on
    // every project in the graph, and a referenced project a `tsc -b` build
    // relies on for cross-project types may not have emit disabled (TS6310).
    // The only combination that satisfies both constraints is: the generated
    // client is a normal, *included* part of this one project, and this one
    // flag — which only the generated client's own internals ever trip, per
    // `git blame` on every occurrence — is off for the whole project.
    // `tsconfig.base.json` (every backend package) keeps it on; this is an
    // apps/web-only, generated-code-only relaxation.
    "exactOptionalPropertyTypes": false,
    // TS 6.0 deprecated `baseUrl`; `paths` below still needs it until every
    // path is rewritten relative to a `paths`-less resolution root.
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src", "vitest.setup.ts"],
  // `src/sw.ts` has its own project (tsconfig.sw.json — a different `lib`).
  "exclude": ["src/sw.ts"]
}
