{
  "name": "personalfi",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=26.0.0 <27.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "pnpm run lint:format && pnpm run lint:eslint && pnpm run lint:schema-ownership",
    "lint:eslint": "eslint .",
    "lint:schema-ownership": "node scripts/check-schema-ownership.ts",
    "lint:format": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node packages/db/src/cli/migrate.ts",
    "openapi": "node apps/api/src/cli/emit-openapi.ts",
    "dev:api": "node --watch apps/api/src/main.ts",
    "dev:worker": "node --watch apps/api/src/worker.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.9.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
