{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personalfi.local/contracts/advisor/v1/response.schema.json",
  "title": "PersonalFi AdvisorResponse v1",
  "description": "Proposed insights. requires_review is the literal true and there is no status field, so no return value can cause an action; proposed_actions[].kind has four non-acting members; evidence is non-empty at the type level and every source_ref must resolve into the snapshot we sent (08 §4.3).",
  "contractVersion": 1,
  "artefactVersion": "1.5.0",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "number",
      "const": 1
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "advisor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "advisor_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "produced_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T[0-9:.]+Z$"
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "runtime_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 96
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 240
          }
        }
      },
      "required": ["runtime_ms", "model", "warnings"],
      "additionalProperties": false
    },
    "insights": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "period": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "severity": {
            "type": "string",
            "enum": ["info", "notable", "warning", "urgent"]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "summary_md": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "confidence_basis": {
            "type": "string",
            "enum": ["deterministic", "heuristic", "model"]
          },
          "horizon": {
            "type": "string",
            "enum": ["immediate", "this_period", "next_quarter", "this_year", "long_term"]
          },
          "requires_review": {
            "type": "boolean",
            "const": true
          },
          "impact": {
            "type": "object",
            "properties": {
              "annualized": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "minor": {
                        "type": "string",
                        "pattern": "^-?\\d{1,20}$"
                      },
                      "currency": {
                        "type": "string",
                        "pattern": "^[A-Z]{3}$"
                      }
                    },
                    "required": ["minor", "currency"],
                    "additionalProperties": false,
                    "description": "Money as minor units in a string, paired with an ISO-4217 code."
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "one_time": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "minor": {
                        "type": "string",
                        "pattern": "^-?\\d{1,20}$"
                      },
                      "currency": {
                        "type": "string",
                        "pattern": "^[A-Z]{3}$"
                      }
                    },
                    "required": ["minor", "currency"],
                    "additionalProperties": false,
                    "description": "Money as minor units in a string, paired with an ISO-4217 code."
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "basis": {
                "type": "string",
                "maxLength": 240
              },
              "derivation_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 64
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": ["annualized", "one_time", "basis", "derivation_id"],
            "additionalProperties": false
          },
          "evidence": {
            "minItems": 1,
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["metric", "transaction", "series", "budget_line", "external"]
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 160
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "source_ref": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512,
                      "pattern": "^(snapshot:[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+|\\[\\d{1,4}\\])*|external:https:\\/\\/\\S+)$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "url": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 2048
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["kind", "label", "value", "source_ref", "url"],
              "additionalProperties": false
            }
          },
          "derivations": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9_.-]+$"
                },
                "expression": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "inputs": {
                  "minItems": 1,
                  "maxItems": 16,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512,
                    "pattern": "^(snapshot:[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+|\\[\\d{1,4}\\])*|external:https:\\/\\/\\S+)$"
                  }
                },
                "value": {
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)?$"
                },
                "note": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 240
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["id", "expression", "inputs", "value", "note"],
              "additionalProperties": false
            }
          },
          "proposed_actions": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["suggest_only", "open_url", "create_goal_draft", "create_rule_draft"]
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "rationale_md": {
                  "type": "string",
                  "maxLength": 1000
                },
                "url": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 2048
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["kind", "label", "rationale_md", "url"],
              "additionalProperties": false
            }
          },
          "caveats": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 240
            }
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}T[0-9:.]+Z$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "key",
          "period",
          "type",
          "severity",
          "title",
          "summary_md",
          "confidence",
          "confidence_basis",
          "horizon",
          "requires_review",
          "impact",
          "evidence",
          "derivations",
          "proposed_actions",
          "caveats",
          "expires_at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contract_version",
    "request_id",
    "advisor_id",
    "advisor_version",
    "produced_at",
    "diagnostics",
    "insights"
  ],
  "additionalProperties": false
}
