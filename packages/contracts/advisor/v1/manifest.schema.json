{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personalfi.local/contracts/advisor/v1/manifest.schema.json",
  "title": "PersonalFi AdvisorManifest v1",
  "description": "What an advisor declares at registration: the scopes it may read, the capabilities it claims (deterministic is reserved for builtin and is checked), its severity ceiling, the limits we floor against the platform ceiling, and its egress allow-list.",
  "contractVersion": 1,
  "artefactVersion": "1.2.0",
  "type": "object",
  "properties": {
    "advisor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "contract_version": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "enum": ["builtin", "local_model", "external"]
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "requires_scopes": {
      "minItems": 1,
      "maxItems": 13,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "networth.summary",
          "cash.summary",
          "cashflow.monthly",
          "budgets.status",
          "recurring.list",
          "goals.list",
          "risk.profile",
          "market.watchlist",
          "holdings.aggregate",
          "holdings.detail",
          "transactions.summary",
          "transactions.raw",
          "institutions.names",
          "liabilities.terms",
          "market.rates"
        ]
      }
    },
    "triggers": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "schedule"
              },
              "cron": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "required": ["type", "cron"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "event"
              },
              "event_type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
              }
            },
            "required": ["type", "event_type"],
            "additionalProperties": false
          }
        ]
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "deterministic": {
          "type": "boolean"
        },
        "produces_impact": {
          "type": "boolean"
        },
        "narrates_only": {
          "type": "boolean"
        },
        "max_severity": {
          "type": "string",
          "enum": ["info", "notable", "warning", "urgent"]
        }
      },
      "required": ["deterministic", "produces_impact", "narrates_only", "max_severity"],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300000
        },
        "max_insights": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 262144
        }
      },
      "required": ["timeout_ms", "max_insights", "max_response_bytes"],
      "additionalProperties": false
    },
    "egress_allowlist": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253
      }
    }
  },
  "required": [
    "advisor_id",
    "version",
    "contract_version",
    "kind",
    "display_name",
    "purpose",
    "requires_scopes",
    "triggers",
    "capabilities",
    "limits",
    "egress_allowlist"
  ],
  "additionalProperties": false
}
