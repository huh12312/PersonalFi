{
  "openapi": "3.1.0",
  "info": {
    "title": "PersonalFi API",
    "description": "Self-hosted personal finance and advisory. Single user, zero public ingress. Errors are RFC 9457 problem details; clients switch on `code`, never on `detail`.",
    "version": "0.1.0",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "components": {
    "schemas": {}
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Liveness probe",
        "tags": [
          "system"
        ],
        "description": "Always answers if the process is running. Does not touch the database.",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "operationId": "getReady",
        "summary": "Readiness probe",
        "tags": [
          "system"
        ],
        "description": "Reports 503 until the database is reachable and every migration is applied.",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          },
          "503": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080"
    }
  ],
  "tags": [
    {
      "name": "system",
      "description": "Liveness, readiness, and operational endpoints."
    }
  ]
}
