      "published": [
        {
          "claim": "sustainable",
          "text": "Using these decision rules, Guyton calculated the maximum initial withdrawal rate for this period to be 5.8 percent for a portfolio containing 50 percent equities",
          "source": "Guyton & Klinger, \"Decision Rules and Maximum Initial Withdrawal Rates\", Journal of Financial Planning, March 2006, p. 2 (FPA PDF, https://www.financialplanningassociation.org/sites/default/files/2021-11/2006%20-%20Guyton%20and%20Klinger%20-%20Decision%20Rules%20and%20SWR%20(1).PDF), summarising Guyton, JFP October 2004",
          "asserted_as": "the unmodified rules at 5.8% / 50% equity leave the 1973 portfolio above zero for all 30 years"
        },
        {
          "claim": "cuts_in_first_decade",
          "text": "a retirement distribution period beginning in 1973, chosen for its real-life \"perfect storm\" characteristics that included a severe market decline in the initial retirement years combined with inflation in the first decade of retirement that was three times the long-term historical norm",
          "source": "Guyton & Klinger 2006, p. 2",
          "asserted_as": "every capital-preservation cut falls in 1973–1982, and no prosperity raise comes before 1983"
        },
        {
          "claim": "worse_than_2000_after_five_years",
          "text": "the combined impact of inflation and the 1973–1974 bear market placed a 1973 retiree in a more financially uncertain position after five years of retirement at the end of 1977 than a 2000 retiree found after 2004 following the 2000–2002 bear market",
          "source": "Guyton & Klinger 2006, p. 2",
          "asserted_as": "with the same constant real withdrawal, real wealth after five years is lower for the 1973 cohort than for the 2000 cohort; and under the rules the 1973 retiree has already cut deeper by year five"
        }
      ]
    },
