# SPDX-License-Identifier: MIT
#
# Non-secret deployment configuration only.
#
# Secrets are NEVER env vars: they are files under SECRETS_DIR (Docker secrets
# mount at /run/secrets). Env vars leak into `docker inspect`, crash dumps, and
# every child process; a file can be mode 0400 and owned by the app user.
#
# The one exception is DATABASE_URL, which may be set here for local development.
# In production write it to ${SECRETS_DIR}/database_url instead, and the file wins.
#
# Copy to .env for local use. .env is gitignored; keep it that way.

NODE_ENV=development

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable logs for a terminal. Never true in production: it costs a
# dependency at runtime and makes logs unparseable.
LOG_PRETTY=true

# Loopback only. Caddy or Tailscale owns exposure; never bind 0.0.0.0 on a
# machine holding financial data.
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
BASE_URL=http://127.0.0.1:8080

# How many reverse-proxy hops sit in front of this process (M-1;
# packages/config/src/schema.ts). Each increment takes exactly that many
# entries off the right of X-Forwarded-For before trusting what's left, so
# the rate limiter and lockout key on the real client no matter what a
# client-supplied prefix on the header claims. `0` disables forwarded-header
# parsing entirely (a process reached directly, with no proxy in front of
# it). The default of `1` matches this repo's own topology: one Caddy hop
# between the client and this process. Raise it only when a second proxy is
# genuinely in the path — every increment hands one more hop of the chain to
# whoever can reach the one below.
TRUST_PROXY=1

# ---------------------------------------------------------------------------
# The public hostname (compose.yml + docker/Caddyfile)
# ---------------------------------------------------------------------------
# ONE name for one fact. PUBLIC_HOST (renamed from PERSONALFI_HOSTNAME) sets,
# together: Caddy's site address and internal-CA certificate, the API's
# BASE_URL, AUTH_RP_ID (the WebAuthn relying-party id), and the single entry in
# AUTH_ALLOWED_ORIGINS (the CSRF origin allow-list). They were four independent
# settings once; compose set only the first, so the API ran as `localhost`
# while serving `https://personalfi.lan` and nobody could log in (P0-4).
#
# Changing this after passkeys are enrolled INVALIDATES EVERY PASSKEY — the RP
# id is bound into the credential. Pick the final hostname before enrolling.
PUBLIC_HOST=personalfi.lan

# Optional, comma-separated, appended to AUTH_ALLOWED_ORIGINS. Only for another
# origin on the SAME registrable name (a different port, or a subdomain of
# PUBLIC_HOST). NOT a way to add a Tailscale MagicDNS name: WebAuthn §7.1
# requires every allowed origin's host to be AUTH_RP_ID or a subdomain of it,
# and @core/config refuses to boot otherwise — deliberately, so the failure is
# a startup error rather than a browser that silently declines the ceremony.
# For passkeys over Tailscale, set PUBLIC_HOST to the tailnet name instead.
# EXTRA_ALLOWED_ORIGINS=https://personalfi.lan:8443

# The address Caddy's published ports bind to. Never 0.0.0.0 on a machine
# holding financial data; scripts/compose-hardening-check.sh fails the build on
# a published port with no explicit address.
BIND_ADDRESS=127.0.0.1

# `just db-up` serves this on 5433 so it cannot collide with a system Postgres.
DATABASE_URL=postgres://personalfi:personalfi@127.0.0.1:5433/personalfi_dev
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000

# Where file-mounted secrets live. /run/secrets under Docker; a local directory
# in development.
SECRETS_DIR=./secrets

# Boots with a deterministic synthetic dataset and hard-disables every real
# provider client at construction time. WP 0.1 defines the flag; the generator
# arrives with the seed package.
DEMO_MODE=false

# ---------------------------------------------------------------------------
# Compose stack knobs (compose.yml). All non-secret.
# ---------------------------------------------------------------------------
# Host ports the proxy publishes, on BIND_ADDRESS only. Caddy itself always
# listens on unprivileged 8443/8080 inside the container so the proxy needs no
# NET_BIND_SERVICE and keeps cap_drop: [ALL].
# PROXY_HTTPS_PORT=443
# PROXY_HTTP_PORT=80

# Nightly backup schedule and local retention (docker/backup/backup-loop.sh).
# BACKUP_HOUR_UTC=2
# BACKUP_RETENTION_DAYS=30

# Empty (default) = local-only backups. Set to e.g. "b2:personalfi-backups" to
# also push to Backblaze B2; see RUNBOOK.md "Backup".
# RCLONE_REMOTE=

# ---------------------------------------------------------------------------
# Plaid (compose.yml; C-3, gate-security-review.md §2.2 F-2/§6 C-3)
# ---------------------------------------------------------------------------
# The credentials themselves (Client ID, secret, sandbox|production) are file
# secrets under ${SECRETS_DIR}/plaid_client_id, plaid_secret, plaid_env — never
# env vars (01 §1.10) — see RUNBOOK.md "Create secrets". Everything below is
# non-secret shape, feature-detected off the presence of those files.
#
# Whether the api/worker containers *have* Plaid secrets and whether the proxy
# *widens its CSP* for cdn.plaid.com/sandbox.plaid.com/production.plaid.com
# (docker/Caddyfile) are two different mechanisms that must be told the same
# fact separately — the api reads the secret files itself; the proxy cannot.
# Set this to true only once secrets/plaid_client_id and secrets/plaid_secret
# actually have content; leave it false (the default) otherwise, or the proxy
# widens the CSP for a connector that is not registered.
# PLAID_ENABLED=true

# Only needed for an OAuth institution (D12) — most US banks do not need one.
# Must be https, and its origin must be one of AUTH_ALLOWED_ORIGINS above (the
# same origin PUBLIC_HOST serves): @core/config refuses to boot otherwise,
# rather than letting Plaid Link send a browser back to a page this deployment
# does not actually serve. Typically https://<PUBLIC_HOST>/link/oauth.
# PLAID_REDIRECT_URI=https://personalfi.lan/link/oauth

# Image registry/tag for the three images this repo builds.
# REGISTRY=personalfi
# PERSONALFI_VERSION=dev
