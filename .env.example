# SPDX-License-Identifier: MIT
#
# Non-secret deployment configuration only.
#
# Secrets are NEVER env vars: they are files under SECRETS_DIR (Docker secrets
# mount at /run/secrets). Env vars leak into `docker inspect`, crash dumps, and
# every child process; a file can be mode 0400 and owned by the app user.
#
# The one exception is DATABASE_URL, which may be set here for local development.
# In production write it to ${SECRETS_DIR}/database_url instead, and the file wins.
#
# Copy to .env for local use. .env is gitignored; keep it that way.

NODE_ENV=development

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable logs for a terminal. Never true in production: it costs a
# dependency at runtime and makes logs unparseable.
LOG_PRETTY=true

# Loopback only. Caddy or Tailscale owns exposure; never bind 0.0.0.0 on a
# machine holding financial data.
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
BASE_URL=http://127.0.0.1:8080

# How many reverse-proxy hops sit in front of this process (M-1;
# packages/config/src/schema.ts). Each increment takes exactly that many
# entries off the right of X-Forwarded-For before trusting what's left, so
# the rate limiter and lockout key on the real client no matter what a
# client-supplied prefix on the header claims. `0` disables forwarded-header
# parsing entirely (a process reached directly, with no proxy in front of
# it). The default of `1` matches this repo's own topology: one Caddy hop
# between the client and this process. Raise it only when a second proxy is
# genuinely in the path — every increment hands one more hop of the chain to
# whoever can reach the one below.
TRUST_PROXY=1

# ---------------------------------------------------------------------------
# The public hostname (compose.yml + docker/Caddyfile)
# ---------------------------------------------------------------------------
# ONE name for one fact. PUBLIC_HOST (renamed from PERSONALFI_HOSTNAME) sets,
# together: Caddy's site address and internal-CA certificate, the API's
# BASE_URL, AUTH_RP_ID (the WebAuthn relying-party id), and the single entry in
# AUTH_ALLOWED_ORIGINS (the CSRF origin allow-list). They were four independent
# settings once; compose set only the first, so the API ran as `localhost`
# while serving `https://personalfi.lan` and nobody could log in (P0-4).
#
# Changing this after passkeys are enrolled INVALIDATES EVERY PASSKEY — the RP
# id is bound into the credential. Pick the final hostname before enrolling.
PUBLIC_HOST=personalfi.lan

# Optional, comma-separated, appended to AUTH_ALLOWED_ORIGINS. Only for another
# origin on the SAME registrable name (a different port, or a subdomain of
# PUBLIC_HOST). NOT a way to add a Tailscale MagicDNS name: WebAuthn §7.1
# requires every allowed origin's host to be AUTH_RP_ID or a subdomain of it,
# and @core/config refuses to boot otherwise — deliberately, so the failure is
# a startup error rather than a browser that silently declines the ceremony.
# For passkeys over Tailscale, set PUBLIC_HOST to the tailnet name instead.
# EXTRA_ALLOWED_ORIGINS=https://personalfi.lan:8443

# The address Caddy's published ports bind to. Never 0.0.0.0 on a machine
# holding financial data; scripts/compose-hardening-check.sh fails the build on
# a published port with no explicit address.
BIND_ADDRESS=127.0.0.1

# `just db-up` serves this on 5433 so it cannot collide with a system Postgres.
DATABASE_URL=postgres://personalfi:personalfi@127.0.0.1:5433/personalfi_dev
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000

# Where file-mounted secrets live. /run/secrets under Docker; a local directory
# in development.
SECRETS_DIR=./secrets

# Boots with a deterministic synthetic dataset and hard-disables every real
# provider client at construction time. WP 0.1 defines the flag; the generator
# arrives with the seed package.
DEMO_MODE=false

# ---------------------------------------------------------------------------
# Compose stack knobs (compose.yml). All non-secret.
# ---------------------------------------------------------------------------
# Host ports the proxy publishes, on BIND_ADDRESS only. Caddy itself always
# listens on unprivileged 8443/8080 inside the container so the proxy needs no
# NET_BIND_SERVICE and keeps cap_drop: [ALL].
# PROXY_HTTPS_PORT=443
# PROXY_HTTP_PORT=80

# Nightly backup schedule and local retention (docker/backup/backup-loop.sh).
# BACKUP_HOUR_UTC=2
# BACKUP_RETENTION_DAYS=30

# Empty (default) = local-only backups. Set to e.g. "b2:personalfi-backups" to
# also push to Backblaze B2; see RUNBOOK.md "Backup".
# RCLONE_REMOTE=

# ---------------------------------------------------------------------------
# Plaid (compose.yml; C-3, gate-security-review.md §2.2 F-2/§6 C-3)
# ---------------------------------------------------------------------------
# The credentials themselves (Client ID, secret, sandbox|production) are file
# secrets under ${SECRETS_DIR}/plaid_client_id, plaid_secret, plaid_env — never
# env vars (01 §1.10) — see RUNBOOK.md "Create secrets". Everything below is
# non-secret shape, feature-detected off the presence of those files.
#
# Whether the api/worker containers *have* Plaid secrets and whether the proxy
# *widens its CSP* for cdn.plaid.com/sandbox.plaid.com/production.plaid.com
# (docker/Caddyfile) are two different mechanisms that must be told the same
# fact separately — the api reads the secret files itself; the proxy cannot.
# Set this to true only once secrets/plaid_client_id and secrets/plaid_secret
# actually have content; leave it false (the default) otherwise, or the proxy
# widens the CSP for a connector that is not registered.
# PLAID_ENABLED=true

# Only needed for an OAuth institution (D12) — most US banks do not need one.
# Must be https, and its origin must be one of AUTH_ALLOWED_ORIGINS above (the
# same origin PUBLIC_HOST serves): @core/config refuses to boot otherwise,
# rather than letting Plaid Link send a browser back to a page this deployment
# does not actually serve. Typically https://<PUBLIC_HOST>/link/oauth.
# PLAID_REDIRECT_URI=https://personalfi.lan/link/oauth

# ---------------------------------------------------------------------------
# Phase 2 wiring (02-phase-2-dispatch.md §4; docs/evidence/phase-2/wp2.w-wiring.md)
# ---------------------------------------------------------------------------
# @ctx/notifications's egress allow-list — the destination hosts this
# deployment's ntfy/SMTP channels may ever reach. Comma-separated, lowercase
# hostnames only: no wildcard, no IP literal (both are refused at boot). Empty
# (the default) means every send is refused `host_not_allowed` — a
# notification channel is the first outbound path a *user-supplied string*
# controls, so an operator who has not named a host has not consented to one.
# NOTIFICATIONS_ALLOWED_HOSTS=ntfy.example.ts.net,smtp.example.com

# The @ctx/insights merchant-pseudonymisation secret (wp2.6-insights.md §6,
# open item 5) is a **file** secret, never an env var — see RUNBOOK.md
# "Create secrets". With no ${SECRETS_DIR}/advisor_token_secret present,
# module.insights registers no consumer, no job and no schedule; it is not an
# error, only "not opted in yet".

# ---------------------------------------------------------------------------
# Phase 3 wiring (03-phase-3-dispatch.md §4; docs/evidence/phase-3/wp3.w-wiring.md)
# ---------------------------------------------------------------------------
# @ctx/integrations's egress allow-list. Same syntax and same refusals as
# NOTIFICATIONS_ALLOWED_HOSTS above — comma-separated lowercase hostnames, no
# wildcard, no IP literal — but the DEFAULT IS THE OPPOSITE WAY ROUND, and the
# difference matters.
#
# A notification channel dials a host a *user-supplied string* names, so empty
# means deny-all. A market-data adapter dials a host *the code* names, one per
# adapter, pinned in packages/contexts/integrations/src/egress.ts:
#
#     api.tiingo.com  api.stlouisfed.org  api.coingecko.com  api.openfigi.com
#
# So empty here (the default) means "use those four", and a non-empty value can
# only NARROW that set — it is intersected, never substituted. Listing only
# some of them is how you switch a provider off without deleting its key; there
# is deliberately no way to add a host from the environment, because an env var
# that could widen an egress allow-list is a way to repoint a price fetcher by
# editing a file.
# MARKET_DATA_ALLOWED_HOSTS=api.tiingo.com,api.coingecko.com

# The same, for the crypto connectors: api.coinbase.com (WP 3.5),
# blockstream.info and api.etherscan.io (WP 3.6's watch-only wallets).
# Empty (the default) means "use those three"; a non-empty value can only
# NARROW the set. Naming only `blockstream.info` is how an operator keeps the
# Bitcoin leg and switches the Ethereum one off without deleting its key.
# CRYPTO_ALLOWED_HOSTS=api.coinbase.com

# Seven new **file** secrets, never env vars (D5). All optional, all
# feature-detected: with a key absent its adapter answers `skipped_no_key` and
# the app boots normally — 03 §6, "Phase 3 completes with zero keys; it just
# cannot prove freshness". Compose has no optional-secret model, so RUNBOOK.md
# "Create secrets" has you create each one **empty**; packages/config treats a
# zero-length file exactly as a missing one.
#
#   ${SECRETS_DIR}/tiingo_api_key       equity/ETF/fund EOD closes
#   ${SECRETS_DIR}/fred_api_key         macro series and FX (key travels in the
#                                       query string — FRED has no header auth)
#   ${SECRETS_DIR}/coingecko_api_key    crypto, Demo plan
#   ${SECRETS_DIR}/openfigi_api_key     symbol -> FIGI mapping (also answers
#                                       anonymously, at 10 jobs/batch not 100)
#   ${SECRETS_DIR}/coinbase_key_name    organizations/{org}/apiKeys/{key}
#   ${SECRETS_DIR}/coinbase_private_key the CDP **Ed25519** key (EdDSA, not
#                                       ES256 — that is Plaid's *webhook*
#                                       algorithm). Create the CDP key with
#                                       `view` permission only: the connector
#                                       asserts key_permissions at startup and
#                                       refuses a key that can trade.
#   ${SECRETS_DIR}/etherscan_api_key    Etherscan v2, for the watch-only wallet
#                                       connector's ETHEREUM leg only (WP 3.6).
#                                       The BITCOIN leg needs no key: addresses
#                                       are derived locally from the xpub and
#                                       Blockstream Esplora is unauthenticated.
#                                       With no key the connector is still
#                                       registered and BTC wallets work; an ETH
#                                       balance request refuses BY NAME rather
#                                       than dialling.
#
# The coinbase pair is all-or-nothing: one file without the other is a boot
# error, not a silently half-configured connector. All seven are mounted on
# `api` and `worker` only — never on `migrator`, which applies DDL and will
# never dial a provider — and all seven are covered by `just harden-secrets`.

# ---------------------------------------------------------------------------
# Phase 5 wiring (05-phase-5-dispatch.md §2/§4 item 9)
# ---------------------------------------------------------------------------
# Kill switch 1 of WP 5.1's four-level advisor ladder — the global on/off for
# every advisor, builtin or local-model. `true` (the default) is correct for
# a fresh install; flip it to `false` to stop every advisor run without
# touching module.insights or redeploying.
# ADVISORS_ENABLED=true

# The `local_model` advisor kind's endpoint (WP 5.1/5.2), feature-detected the
# same way Plaid is: empty/absent (the default) means this deployment has not
# configured a local model, and no local_model advisor is registered — kill
# level 2 of WP 5.1's ladder. A single-label compose service name and port
# (e.g. ollama:11434) — LOCAL_MODEL_ALLOW_REMOTE below is the only way to
# point this at a LAN box, and then only over https.
# LOCAL_MODEL_ENDPOINT=ollama:11434

# Required once LOCAL_MODEL_ENDPOINT is set; @core/config refuses to boot
# otherwise. The model name pulled through the local-llm-pull profile.
# LOCAL_MODEL_NAME=qwen2.5:7b-instruct-q4_K_M

# Required once LOCAL_MODEL_ENDPOINT is set; @core/config refuses to boot
# otherwise. sha256: followed by 64 lowercase hex characters — the model is
# pinned by digest like an image (05 §3 WP 5.2), copied verbatim from what
# `GET /api/tags` reports for the pulled model. The value below is the
# reference model's registry-manifest digest as pinned by WP 5.2
# (docs/evidence/phase-5/wp5.2-local-model.md); a different tag is a different
# digest, and the run refuses `model_digest_mismatch` until they agree.
# LOCAL_MODEL_DIGEST=sha256:845dbda0ea48ed749caafd9e6037047aa19acfcfd82e704d7ca97d631a0b697e

# Milliseconds. Defaults to 180000 and can never be configured above the
# platform's own advisor-run ceiling (300000, packages/contexts/insights/src/
# contract/manifest.ts's PLATFORM_LIMITS.timeoutMs) — @core/config refuses a
# higher value at boot.
# LOCAL_MODEL_TIMEOUT_MS=180000

# Off by default (05 §6 Q2): Ollama stays on this host, on an internal
# compose network, unless you explicitly opt a LAN box in — and then only
# over https, enforced by WP 5.2's local-endpoint policy, not by this flag.
# LOCAL_MODEL_ALLOW_REMOTE=false

# WP 9.6 (CF-1 / Phase 5 gate R-4): what the api is told about the local model
# so "Approve this payload" works through the product. The api never learns
# where the model is -- only worker holds LOCAL_MODEL_ENDPOINT -- so these are
# the model's NAME and DIGEST and nothing else. Both or neither: a half is a
# boot error. compose.yml defaults them to LOCAL_MODEL_NAME and
# LOCAL_MODEL_DIGEST above, so you set the model once; set these only to pin
# the api to something else. With no model configured the api refuses a preview
# with 503 insights.prompt_renderer_unavailable and says why.
# LOCAL_MODEL_PIN_NAME=qwen2.5:7b-instruct-q4_K_M
# LOCAL_MODEL_PIN_DIGEST=sha256:845dbda0ea48ed749caafd9e6037047aa19acfcfd82e704d7ca97d631a0b697e

# WP 9.6 item 3 / Phase 5 gate R-2. A Brief item always says whether a narration
# exists (the "AI-assisted wording" badge); the narration's TEXT is shown to the
# holder only when this is true. Off by default and not flipped by the app: it
# is turned on only after the narrator's figure slots (WP 9.5 option B) have
# landed and been measured, or the holder has accepted the residual in writing.
# NARRATION_TEXT_SHOWN=false

# The Monte Carlo concurrency cap (wp4.5 §4.5, wp4.w-wave-c §5 item 1),
# replacing the MAX_CONCURRENT_MONTE_CARLO_RUNS literal one-for-one. Defaults
# to 8, unchanged from what it replaces.
# MONTE_CARLO_MAX_CONCURRENT=8

# Image registry/tag for the three images this repo builds.
#
# PRODUCTION (WP 9.1, 09 §4 batch 4; RUNBOOK "Production install and the
# real-use soak"): PERSONALFI_VERSION is REQUIRED and must be the 40-hex SHA
# the install was built from — never `dev`. `scripts/soak/check-isolation.sh`
# refuses `dev`, and a `dev` tag would let a later `docker compose build` from
# any checkout silently replace production's images. Upgrade by setting it to
# the new SHA and running `just upgrade` (RUNBOOK "Upgrade").
# PRODUCTION also sets COMPOSE_PROJECT_NAME=personalfi-prod: the clone's own
# compose project, hence its own volumes, networks and container names, which
# is what keeps a dev or gate `down -v` on `personalfi` away from real data
# (WP 9.1, Phase 9 rule 5; `scripts/soak/check-isolation.sh` checks it).
# REGISTRY=personalfi
# PERSONALFI_VERSION=dev
# COMPOSE_PROJECT_NAME=personalfi
