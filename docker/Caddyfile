#
# Zero-public-ingress by default (D12). Two ways this gets reached:
#
#   1. LAN mode (default). Caddy's internal CA issues a real certificate for
#      `personalfi.lan` with no ACME and no public DNS. Install the root CA
#      once per client with `just trust-ca` (RUNBOOK.md). This is what
#      `docker compose up` gives you out of the box.
#
#   2. Tailscale Serve (remote access). Tailscale runs on the HOST (not as a
#      compose service — it needs no route into `backend` or `sidecar`, only
#      into whatever Caddy publishes on 127.0.0.1), terminates TLS itself with
#      a real Let's Encrypt certificate from the tailnet's MagicDNS name, and
#      reverse-proxies to Caddy's plain-HTTP internal listener:
#
#        tailscale serve --bg --https=443 http://127.0.0.1:${PROXY_HTTP_PORT:-80}
#
#      Serve (never Funnel) keeps this on the tailnet only, authenticated by
#      WireGuard device identity — see RUNBOOK.md "Enabling remote access".
#      Because Tailscale already terminates TLS for that path, Caddy's own
#      `tls internal` on the LAN hostname is untouched and irrelevant to it.
#
# Caddy listens on unprivileged container ports (8443/8080), mapped by compose
# to whatever host ports are configured — never 0.0.0.0, only the configured
# bind address — so the proxy container needs no NET_BIND_SERVICE capability
# and keeps `cap_drop: [ALL]` with zero exceptions.
#
# BOTH listeners are the same application, so both get the same headers and the
# same routes, from the same two snippets. The Phase 0 security gate (H-4) found
# the :8080 listener — the *remote-access* path — shipping three headers where
# the LAN listener shipped eleven: no CSP, no HSTS, no framing protection on
# every Tailscale session. Two hand-maintained copies of one policy is how that
# happens, so there is now exactly one copy of each.
{
	admin off
	email {$CADDY_ACME_EMAIL:chris@thebrutus.org}
	# `tls internal` below issues from this local CA; no ACME account is
	# actually used while LAN mode is the only mode in play.
}

# ---------- one security-header policy, imported by every listener ----------
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"

		# No nonce. The previous policy emitted `'nonce-{nonce-placeholder}'`,
		# which nothing substituted: `{` and `}` are outside CSP's base64
		# grammar, so browsers discarded the source expression and the
		# *effective* policy was `script-src 'self'` — fail-safe by luck (H-4,
		# M-7). The tempting fix (bake a constant into the image) is strictly
		# weaker than `'self'`, because a public constant nonce whitelists any
		# injected script that copies it. So this states what is actually
		# enforced today, and docs/security/csp-nonce-strategy.md keeps the
		# per-request-nonce target on file for when the serving layer can mint
		# one per response.
		#
		# `style-src-elem` / `style-src-attr` are split per that document:
		# React writes `style="..."` attributes for dynamic values (chart
		# geometry, progress arcs) that cannot carry a nonce, while injected
		# `<style>` elements — sonner and react-remove-scroll-bar both do this
		# at runtime — are served from 'self'. Collapsing both into a single
		# `style-src 'self'` is what would have broken the idle-lock warning
		# toast and the service-worker update prompt.
		#
		# `worker-src blob:` is required by the vite-plugin-pwa service worker
		# registration; `img-src blob:` by canvas/chart exports.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src-elem 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		-Server
	}
}

# ---------- one routing policy, imported by every listener ----------
#
# The API mounts exactly three prefixes (packages/contracts/openapi/openapi.json:
# `/auth/*`, `/health`, `/ready`). Everything else is the SPA, served straight
# off disk by this container from the `apps/web` bundle baked into the image by
# docker/caddy.Dockerfile.
#
# The old file had a `handle /api/*` block that proxied to `api:8080` *without*
# stripping the prefix, against an API that mounts nothing under `/api` — every
# request through it 404'd (M-3), and because the block looked load-bearing,
# the catch-all that actually served traffic was the one place missing
# `X-Forwarded-Proto`. It is gone; the three real prefixes are listed by name.
#
# Trusted-proxy posture, stated rather than inherited (C-1/M-1):
#   * No `trusted_proxies` directive appears anywhere in this file, on either
#     listener, so Caddy's default — trust *no* peer's forwarding headers —
#     applies. Since Caddy 2.7 that default means an inbound `X-Forwarded-For`
#     from a client is REPLACED, not appended to.
#   * `header_up X-Forwarded-For {remote_host}` overwrites it unconditionally
#     anyway, so the API's rate limiter and lockout key on the real peer
#     address whatever a future Caddy changes its default to. The security
#     gate found the protection was real but rested entirely on a
#     version-dependent default with nothing pinning it.
#   * Loopback is deliberately NOT trusted on the Tailscale listener. Under
#     the default bridge network the immediate peer for a `tailscale serve`
#     request is the docker-proxy gateway (172.x.0.1), never 127.0.0.1, so a
#     `trusted_proxies static 127.0.0.1/32` there would match nothing and read
#     as a guarantee that is not one. If per-device attribution over the
#     tailnet is ever wanted, the honest way is to trust the gateway address
#     explicitly and consume `Tailscale-User-Login`, not to trust loopback.
#
# `X-Forwarded-Proto https` on every live path: both listeners are reached over
# TLS by the client (Caddy terminates on :8443, Tailscale terminates in front
# of :8080), so `request.protocol` in the API is `https` for every request it
# actually serves.
(app_routes) {
	handle /auth/* {
		reverse_proxy api:8080 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
		}
	}

	handle /health {
		reverse_proxy api:8080 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
		}
	}

	handle /ready {
		reverse_proxy api:8080 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
		}
	}

	# The app's well-known static prefixes/files. Plain `file_server`, no SPA
	# fallback: a miss here (a stale or mistyped hashed asset name, e.g. after
	# `/assets/index-BWySMGlh.js` rolled off in a prior deploy) is a real 404,
	# not a 200 copy of `index.html` (R-9, Low). Before this split, the
	# catch-all's `try_files {path} /index.html` applied to the *whole* site,
	# so every one of these paths answered 200 `text/html` whether the file
	# existed or not — harmless in this app (no source maps ship, see
	# docker/caddy.Dockerfile) but it meant a scanner or a broken deploy could
	# never tell "missing asset" from "app is up" by status code alone. `handle`
	# blocks are sorted by matcher specificity, so this fires before the
	# catch-all below regardless of file order (same pattern as
	# `handle /auth/*` etc. above).
	@staticPaths path /assets/* /fonts/* /icons/* /sw.js /manifest.webmanifest
	handle @staticPaths {
		root * /srv/web
		@immutable path /assets/* /fonts/* /icons/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@nocache path /sw.js /manifest.webmanifest
		header @nocache Cache-Control "no-cache"
		file_server
	}

	# Everything else: the SPA shell plus client-side routes. A deep link like
	# /transactions has no file behind it, and the router resolves it in the
	# browser — but only for *navigation-shaped* requests (no file extension on
	# the final path segment). Anything with an extension that reaches this
	# block (the static prefixes above already caught the app's real assets)
	# is treated as a miss, not a route, and gets file_server's ordinary 404
	# instead of the app shell (R-9). `not file` is Caddy's documented
	# "does this path exist under root?" idiom for SPA serving.
	handle {
		root * /srv/web
		@nocache path / /index.html
		header @nocache Cache-Control "no-cache"
		@spaRoute {
			not file
			not path_regexp \.[a-zA-Z0-9]+$
		}
		rewrite @spaRoute /index.html
		file_server
	}
}

# ---------- LAN mode: personalfi.lan over Caddy's internal CA ----------
{$PUBLIC_HOST:personalfi.lan}:8443 {
	tls internal
	encode zstd gzip
	import security_headers
	import app_routes
}

# ---------- plain HTTP listener for Tailscale Serve to reverse-proxy into ----------
# Deliberately no `tls internal` here: Tailscale terminates TLS itself before
# this is ever reached (see header comment). Only bound to the configured
# LAN/loopback address in compose.yml, same as the HTTPS listener — this is
# not a second public surface, it is the target `tailscale serve` proxies to.
# Identical headers and identical routes to the listener above, by import.
:8080 {
	encode zstd gzip
	import security_headers
	import app_routes
}
